# 노드
SAUCEDUST_NODE_ID=
SAUCEDUST_NODE_ROLE=control
SAUCEDUST_DATA_DIR=
SAUCEDUST_THUMB_DIR=
SAUCEDUST_HEARTBEAT_SECS=30
SAUCEDUST_NODE_TIMEOUT_SECS=90

# 저장소
DATABASE_URL=postgres://sauce:saucepass@localhost:5432/sauce
POSTGRES_MAX_CONNECTIONS=
POSTGRES_ACQUIRE_TIMEOUT_SECS=120
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# 텔레그램 봇. 토큰이 비어 있으면 봇을 띄우지 않습니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_TIMEOUT_SECS=30
# 쓸 수 있는 사용자 번호를 쉼표로 나열합니다.
# 비워 두면 토큰을 아는 누구나 검색할 수 있습니다.
TELEGRAM_ALLOWED_USERS=

# 중앙 서버
SAUCEDUST_CONTROL_URL=http://localhost:8000
# 되돌아오는 주소가 아닌 곳에 열려면 토큰이 있어야 시작합니다.
# 토큰 없이 열면 닿는 누구나 자료를 넣고 검색할 수 있습니다.
# 메시 VPN을 쓴다면 그 주소에만 붙이십시오. 예: 100.x.y.z:8000
SAUCEDUST_CONTROL_BIND=127.0.0.1:8000
# 16자 이상. 모든 노드가 같은 값을 씁니다.
# 만들기: openssl rand -base64 24
SAUCEDUST_CONTROL_TOKEN=

# 임베딩 워커
EMBED_WORKER_URL=http://127.0.0.1:8100
EMBED_BATCH_SIZE=16
EMBED_BATCH_TIMEOUT_MS=50

# 수집 대상
SAUCEDUST_SOURCE_SITE=danbooru
SAUCEDUST_SCOPE_KEY=default
DANBOORU_API_URL=https://danbooru.donmai.us
# 계정을 넣으면 인증된 요청을 보내 더 높은 속도 한도를 받습니다.
# 둘 다 넣거나 둘 다 비워야 합니다.
DANBOORU_LOGIN=
DANBOORU_API_KEY=
INDEX_TAGS=
SAUCEDUST_POLL_SECS=15
SAUCEDUST_USER_AGENT=saucedust/0.2

# 백필
CRAWL_BACKFILL_WORKERS=2
CRAWL_BACKFILL_RANGE_SIZE=10000
# 과거로 내려가는 하한. 이 번호보다 작은 게시물은 아예 보지 않습니다.
# 0이면 1번까지 내려갑니다. 메모리가 넉넉하지 않으면 여기서 막으십시오.
# Qdrant가 붙들 양은 장수에 정비례하고, 모으고 나서는 줄일 수 없습니다.
CRAWL_BACKFILL_FLOOR=0
# 색인 전체가 담을 수 있는 장수. 0이면 재지 않습니다.
# 넘기면 Qdrant가 OOM으로 죽고, 다시 띄워도 컬렉션을 여는 것 자체가
# 한도를 넘어 또 죽습니다. 비워 두면 시작할 때 몇 장이 들어갈지 알려 줍니다.
# 모든 노드가 같은 값을 씁니다. 한계는 중앙의 Qdrant 것입니다.
SAUCEDUST_MAX_INDEXED=0

# 동시성 자동 조절
CRAWL_CONCURRENCY=4
CRAWL_MIN_CONCURRENCY=1
CRAWL_MAX_CONCURRENCY=16
CRAWL_ADAPTIVE=1

# 상대 사이트에 내는 초당 요청 수 상한. 동시 수와 별개로 지켜집니다.
# Danbooru는 IP 단위로 제한하므로 노드를 늘리는 편이 이 값을 올리는 것보다 낫습니다.
CRAWL_RATE_PER_SEC=5
CRAWL_RATE_BURST=8

# 축소본 저장
THUMB_SIZE=384
THUMB_QUALITY=85

# 네트워크 경로 우선순위
SAUCEDUST_NET_ORDER=direct,ech,frag,vpn

# TLS 인사말을 몇 조각으로 나눌지, 조각 사이에 얼마나 쉴지입니다.
# 검사 장비가 조각을 다시 합쳐서 본다면 조각 수를 늘리고 지연을 줘 보십시오.
SAUCEDUST_FRAGMENT_PARTS=3
SAUCEDUST_FRAGMENT_DELAY_MS=0
SAUCEDUST_PROXY_URL=
# 수집 대상이 알려준 주소를 그대로 받아오므로 사설 주소는 기본으로 막습니다.
# 사내 미러를 쓰는 경우에만 켜십시오.
SAUCEDUST_ALLOW_PRIVATE_TARGETS=0
SAUCEDUST_DIRECT_FALLBACK=1
